# Key cho LLM mode llm — dùng cái nào cấu hình trong config.yaml thì điền cái đó
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Chỉ cần nếu dùng endpoint tương thích OpenAI khác (provider custom)
# OPENAI_BASE_URL=https://your-proxy/v1

# Token đọc conversations của platform bot (config.yaml: auth_token_env)
AUTOQA_LIVE_DEMO_TOKEN=eyJ...

# Web UI: dùng MỘT LẦN lúc khởi động để tạo admin đầu tiên vào users.yaml, rồi gỡ
# (sau đó thêm/xoay người qua tab Admin — key sinh ra chỉ hiện một lần)
AUTOQA_ADMIN_KEY=dat-key-khó-đoán-rồi-gỡ

# Supabase — backend dữ liệu (bảng aq_*, schema: supabase/migrations/)
# Không cấu hình → webui chạy chế độ file (local dev). Migrate: python -m autoqa db-migrate
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
